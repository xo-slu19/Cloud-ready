{
  "name": "cloudready",
  "version": "0.1.0",
  "description": "Root workspace for CloudReady, an unofficial AZ-900 practice tool (backend API + frontend).",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "start": "npm start --workspace backend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "test": "npm test --workspace backend && npm test --workspace frontend",
    "smoke": "npm run smoke --workspace backend",
    "build:questions": "npm run build:questions --workspace backend",
    "check:questions": "npm run check:questions --workspace backend"
  },
  "engines": {
    "node": ">=20"
  }
}
