{
  "name": "smart-quiz-builder-backend",
  "version": "0.1.0",
  "description": "Backend API for Smart Quiz Builder, an unofficial AZ-900 practice tool.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "smoke": "node scripts/smoke.js",
    "build:questions": "node scripts/build-question-bank.js",
    "check:questions": "node scripts/check-questions.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  }
}
